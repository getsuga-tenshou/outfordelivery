# Local defaults only. Keep secrets in an ignored .env, shell or credential store.
# Compose and the simulator/run_dbt/upload/export/sync Python CLIs load .env.
# uvicorn and the Databricks CLI do not; export their settings in the shell.
# Existing shell variables take precedence in the Python .env loader.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=outfordelivery-lake


AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local


KAFKA_BOOTSTRAP=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081


# Databricks + Snowflake target (optional). Placeholders only; real values stay in your shell or secret store.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
# Pipeline failure emails default to the deploying user's address. To override,
# export this for Databricks CLI commands; the CLI does not read .env.
# BUNDLE_VAR_notification_email=you@example.com


# dbt on native Snowflake; use scripts/run_dbt.py to supply the shared 120x clock.
# Full transfer runs freshness and build via scripts/sync_snowflake.py.
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/ofd_dbt.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Native snapshot loader uses a separate key and fixed OFD_LOADER role;
# SNOWFLAKE_USER remains the dbt user. Trial/account expiry is separate from key/PAT expiry.
SNOWFLAKE_USER=OFD_DBT
OFD_LOADER_USER=OFD_LOADER
OFD_LOADER_PRIVATE_KEY_PATH=/path/to/ofd_loader.p8
OFD_LOADER_PRIVATE_KEY_PASSPHRASE=
OFD_EXPORTS_DIR=data/exports
DATABRICKS_CONFIG_PROFILE=ofd


# Dashboard live panel: DynamoDB Local by default. For real AWS set OFD_DDB_ENDPOINT= (empty),
# OFD_DDB_TABLE to the Terraform dynamodb_table output and AWS_REGION=eu-central-1; credentials come
# from the default AWS credential chain (for example AWS_PROFILE).
# Remove exported dummy AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_SESSION_TOKEN
# from the dashboard's shell when switching to AWS. Unset endpoint means Local, not AWS.
# Windows PowerShell 5.1 drops empty env values; use the README Python launcher for AWS.
# OFD_DDB_ENDPOINT=http://localhost:8000
# OFD_DDB_TABLE=parcel_state
# Live dimensions must cover all displayed parcel IDs (JSON Lines).
# OFD_PARCELS_PATH=data/parcels.jsonl

# Dashboard basemap: read directly from .env; an exported value takes precedence.
# This browser-visible CARTO Basemaps key is sent only to the tile provider.
CARTO_MAP_API_KEY=

# Dashboard history charts: duckdb (default) or snowflake
OFD_WAREHOUSE=duckdb
# OFD_DUCKDB=dbt/outfordelivery.duckdb
OFD_SF_ACCOUNT=myorg-myaccount
OFD_SF_USER=OFD_DASHBOARD
OFD_SF_PRIVATE_KEY_PATH=/path/to/ofd_dashboard.p8
OFD_SF_PRIVATE_KEY_PASSPHRASE=
